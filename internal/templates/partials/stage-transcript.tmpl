{{define "stage-transcript"}}{{template "logging" .}}
if ($script:WinkitLogVol) { try { Start-Transcript -Path ($script:WinkitLogVol + ':\{{.LogName}}.full') -Append | Out-Null } catch { Write-Output ('[log] transcript failed: ' + $_.Exception.Message) } }
Write-WinkitLog ('=== stage: {{.StageName}} ===')
try {
{{.Script}}
} finally {
    Write-WinkitLog ('=== stage end: {{.StageName}} ===')
    if ($script:WinkitLogVol) { try { Stop-Transcript | Out-Null } catch {} }
}{{end}}