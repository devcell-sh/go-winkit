# winkit-bootstrap.ps1 - generated by winkit (internal/vm/qemu/bootstrap.go).
# Runs once at first logon, launched from the answer volume by
# FirstLogonCommands. Do not edit in the guest; regenerate on the host.
$ErrorActionPreference = 'Stop'
$script:failed = @()
$script:distroOk = $false

# Start a transcript on C: immediately: before the volume scan or anything
# else that can fail: so a bootstrap failure is never invisible. The answer-
# volume transcript is lost when the VM is hard-killed (unflushed FAT writes)
# and absent entirely if the volume is not found; C: is NTFS, always survives,
# and is readable from the disk offline. This is the load-bearing log.
try { Start-Transcript -Path 'C:\winkit-bootstrap.log' -Force } catch { Write-Warning "could not start C: transcript: $_" }

# The answer volume carries the payloads and is the only guest-writable place
# the host can read over the virtio-serial channel. Letters are assigned
# dynamically, so find it by content. Query DEFENSIVELY: a not-ready optical or
# removable drive makes Get-Volume/Test-Path throw, and under
# ErrorActionPreference=Stop that terminating error killed the whole script
# before a single step ran: the real cause of a run where power scheme, SSH
# and every other step silently did nothing. -ErrorAction SilentlyContinue plus
# the try/catch keep a bad drive from taking the bootstrap down with it.
$vol = $null
try {
    foreach ($d in (Get-Volume -ErrorAction SilentlyContinue | Where-Object { $_.DriveLetter })) {
        if (Test-Path ("{0}:\autounattend.xml" -f $d.DriveLetter) -ErrorAction SilentlyContinue) {
            $vol = "{0}:" -f $d.DriveLetter
            break
        }
    }
} catch { Write-Warning "answer-volume scan failed: $_" }

# The scratch FAT volume is the guest-writable place the host can read back.
# Separate from the read-only answer ISO (Joliet).
$writeVol = $null
try {
    foreach ($d in (Get-Volume -ErrorAction SilentlyContinue | Where-Object { $_.DriveLetter })) {
        if (Test-Path ("{0}:\winkit-scratch.marker" -f $d.DriveLetter) -ErrorAction SilentlyContinue) {
            $writeVol = "{0}:" -f $d.DriveLetter
            break
        }
    }
} catch { Write-Warning "scratch-volume scan failed: $_" }

function Send-Progress([string]$msg) {
    $line = "winkit-bootstrap: $msg"
    Write-Output $line
    # COM2 is the PCI 16550 serial port backed by build.jsonl on the host.
    # Uses the inbox serial.sys driver, available immediately without drvload.
    $port = '{{.StructPort}}'
    try {
        $fs = [System.IO.File]::Open($port,
            [System.IO.FileMode]::Open,
            [System.IO.FileAccess]::Write,
            [System.IO.FileShare]::ReadWrite)
        $sw = New-Object System.IO.StreamWriter($fs)
        $sw.WriteLine($line)
        $sw.Flush()
        $sw.Close()
        $fs.Close()
    } catch {
        # Best-effort: the console/transcript still capture $line. Never fail
        # provisioning over a missing side-channel.
        Write-Verbose "progress channel unavailable: $_"
    }
}

{{template "struct-json" .}}

function Invoke-Step([string]$name, [scriptblock]$body) {
    Send-Progress "step: $name"
    winkit-json @{ event = 'bootstrap_step'; stage = $name; status = 'start' }
    try {
        & $body
        Send-Progress "ok: $name"
        winkit-json @{ event = 'bootstrap_step'; stage = $name; status = 'ok' }
    } catch {
        $script:failed += $name
        Send-Progress ("FAILED: {0} -- {1}" -f $name, $_.Exception.Message)
        winkit-json @{ event = 'bootstrap_step'; stage = $name; status = 'fail'; error = $_.Exception.Message }
    }
}

Send-Progress "starting (answer volume: $vol)"
winkit-json @{ event = 'bootstrap_start' }

Invoke-Step 'use the high performance power scheme' {
    powercfg /setactive 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c | Out-Null
    if ($LASTEXITCODE -ne 0) { throw "powercfg /setactive exited $LASTEXITCODE" }
}

Invoke-Step 'never sleep, blank the display or spin down disks' {
    # First, before anything slow: Windows blanks the display after ~10 idle
    # minutes, and the OpenSSH install below runs for over an hour under TCG.
    # Run this later and every screendump for most of the install is an
    # all-black frame, indistinguishable from a hung guest.
    powercfg /change monitor-timeout-ac 0
    powercfg /change monitor-timeout-dc 0
    powercfg /change standby-timeout-ac 0
    powercfg /change standby-timeout-dc 0
    powercfg /change disk-timeout-ac 0
    powercfg /change disk-timeout-dc 0
    powercfg /change hibernate-timeout-ac 0
    powercfg /change hibernate-timeout-dc 0
    powercfg /hibernate off
}

Invoke-Step 'keep the console logged in and unlocked' {
    # autounattend's <LogonCount> is a countdown: Windows decrements it every
    # boot and drops the autologon at zero. The install spends two of them, so
    # a cloned template would stop logging in almost immediately. The registry
    # form has no counter: provided AutoLogonCount is removed, since its
    # presence reinstates the countdown.
    $winlogon = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon'
    Set-ItemProperty -Path $winlogon -Name AutoAdminLogon  -Value '1' -Type String
    Set-ItemProperty -Path $winlogon -Name DefaultUserName -Value '{{.Username}}' -Type String
    Set-ItemProperty -Path $winlogon -Name DefaultPassword -Value '{{.Password}}' -Type String
    Remove-ItemProperty -Path $winlogon -Name AutoLogonCount -ErrorAction SilentlyContinue

    # powercfg keeps the display awake but does not stop the session locking,
    # and a locked console is as opaque to screendumps as a dark one.
    Set-ItemProperty -Path 'HKCU:\Control Panel\Desktop' -Name ScreenSaveActive -Value '0' -Type String
    Set-ItemProperty -Path 'HKCU:\Control Panel\Desktop' -Name ScreenSaverIsSecure -Value '0' -Type String
    $sys = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System'
    if (-not (Test-Path $sys)) { New-Item -Path $sys -Force | Out-Null }
    Set-ItemProperty -Path $sys -Name InactivityTimeoutSecs -Value 0 -Type DWord
    Set-ItemProperty -Path $sys -Name DisableLockWorkstation -Value 1 -Type DWord
    $pers = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\Personalization'
    if (-not (Test-Path $pers)) { New-Item -Path $pers -Force | Out-Null }
    Set-ItemProperty -Path $pers -Name NoLockScreen -Value 1 -Type DWord
}

Invoke-Step 'check network connectivity' {
    $adapters = Get-NetAdapter | Select-Object Name, Status, LinkSpeed, MacAddress, InterfaceDescription
    Send-Progress ("adapters: " + ($adapters | Out-String).Trim())

    $ipCfg = Get-NetIPConfiguration -ErrorAction SilentlyContinue
    Send-Progress ("ip-config: " + ($ipCfg | Out-String).Trim())

    $ips = Get-NetIPAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue |
        Where-Object { $_.IPAddress -ne '127.0.0.1' } |
        Select-Object InterfaceAlias, IPAddress, PrefixLength
    Send-Progress ("ipv4: " + ($ips | Out-String).Trim())

    $routes = Get-NetRoute -AddressFamily IPv4 -ErrorAction SilentlyContinue |
        Where-Object { $_.DestinationPrefix -eq '0.0.0.0/0' }
    Send-Progress ("default-routes: " + ($routes | Out-String).Trim())

    $gw = ($routes | Select-Object -First 1).NextHop
    if ($gw) {
        Send-Progress "gateway: $gw"
        $ping = Test-Connection -ComputerName $gw -Count 1 -Quiet -ErrorAction SilentlyContinue
        Send-Progress "ping gateway: $ping"
    } else {
        Send-Progress "WARNING: no default gateway"
    }

    # QEMU's user-mode gateway. Held in a variable because a literal
    # -ComputerName trips PSScriptAnalyzer's hardcoded-host rule.
    $qemuHostIP = '{{.GuestHostIP}}'
    $qemuHost = Test-Connection -ComputerName $qemuHostIP -Count 1 -Quiet -ErrorAction SilentlyContinue
    Send-Progress "ping QEMU host ($qemuHostIP): $qemuHost"

    try {
        $dns = Resolve-DnsName -Name dns.msftncsi.com -Type A -DnsOnly -ErrorAction Stop
        Send-Progress ("dns: resolved dns.msftncsi.com -> " + ($dns.IPAddress -join ', '))
    } catch {
        Send-Progress ("dns: FAILED to resolve dns.msftncsi.com -- " + $_.Exception.Message)
    }

    # @() wrapping: a single object's .Count is unreliable across the
    # PowerShell editions and WinCompat deserialization this runs under
    # (run 20260903T160300 had adapter Up + 10.0.2.15 yet verdict FAILED).
    $upCount = @($adapters | Where-Object { "$($_.Status)" -eq 'Up' }).Count
    $ipCount = @($ips).Count
    $netOk = ($upCount -gt 0) -and ($ipCount -gt 0)
    Send-Progress "network verdict: $(if ($netOk) { 'OK' } else { 'FAILED' }) (adapters-up=$upCount ipv4=$ipCount)"
    if (-not $netOk) {
        throw "no network adapter is up or no IPv4 address assigned: OpenSSH install requires connectivity"
    }
}

Invoke-Step 'suppress Start menu auto-open on login' {
    # Windows 11 opens the Start menu on the first interactive sign-in.
    # On cloned templates this fires again because the profile is fresh.
    $explorer = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced'
    if (-not (Test-Path $explorer)) { New-Item -Path $explorer -Force | Out-Null }
    Set-ItemProperty -Path $explorer -Name StartShownOnUpgrade -Value 1 -Type DWord
}

Invoke-Step 'allow unattended elevation' {
    # Provisioning runs over SSH, and a network logon hands even an
    # Administrators member a UAC-filtered token: so anything needing real
    # rights fails. Chocolatey demonstrated it exactly: it downloaded and
    # extracted, then refused with "requires Administrative permissions.
    # Please run from elevated prompt."
    #
    # This step is the right place to fix it: FirstLogonCommands already runs
    # elevated, so it can set the policy that later, unelevated sessions need.
    $sys = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System'
    if (-not (Test-Path $sys)) { New-Item -Path $sys -Force | Out-Null }
    # The one that matters for SSH: give network logons the full token.
    Set-ItemProperty -Path $sys -Name LocalAccountTokenFilterPolicy -Value 1 -Type DWord
    # Interactive elevation without a prompt. A prompt cannot be answered
    # headlessly, and UAC's secure desktop does not render reliably over RDP.
    Set-ItemProperty -Path $sys -Name ConsentPromptBehaviorAdmin -Value 0 -Type DWord
    # EnableLUA is deliberately left alone: switching UAC off entirely breaks
    # packaged apps and is a bigger change than this needs.
}
{{- if .SFTPPort}}

Invoke-Step 'mount the host SFTP share as a fixed disk' {
    # The host serves the shared project directory over SFTP (sftpshare
    # package); rclone mounts it through WinFsp with an empty volume prefix,
    # so GetDriveType reports DRIVE_FIXED. That is the point: WSL1 drvfs can
    # stat/read files through the WinFsp FSD but not through MRxDAV's
    # DRIVE_REMOTE path (CELL-532), and some Windows tools refuse network
    # drives outright. Hosts live in variables because literals trip
    # PSScriptAnalyzer's hardcoded-host rule.
    $sftpHost = '{{.GuestHostIP}}'
    $sftpPort = {{.SFTPPort}}

    # WinFsp from the answer volume. The MSI ships byte-exact: FAT cluster
    # padding would break its digital signature.
    $p = Start-Process msiexec.exe -PassThru -Wait -ArgumentList '/i', "$vol\{{.WinFspPayload}}", '/qn', '/norestart'
    if ($p.ExitCode -ne 0) { throw "WinFsp msiexec exited $($p.ExitCode)" }

    # rclone from the answer volume zip (byte-exact: zips are read from the
    # end) into a stable path.
    $rcloneDir = 'C:\Program Files\rclone'
    if (-not (Test-Path $rcloneDir)) { New-Item -ItemType Directory -Path $rcloneDir -Force | Out-Null }
    $tmp = Join-Path $env:TEMP 'rclone-extract'
    Expand-Archive -Path "$vol\{{.RclonePayload}}" -DestinationPath $tmp -Force
    $exe = Get-ChildItem -Path $tmp -Filter rclone.exe -Recurse | Select-Object -First 1
    if (-not $exe) { throw 'rclone.exe not found in the payload zip' }
    $rclone = Join-Path $rcloneDir 'rclone.exe'
    Copy-Item -Path $exe.FullName -Destination $rclone -Force
{{- if .RcloneViaS6}}

    # The mount process itself is owned by the distro's s6 loop (the baked
    # rclone-mount service execs this rclone.exe via WSL1 interop), so this
    # step only installs the machinery. The drive is verified after the s6
    # supervisor starts.
    Send-Progress 'WinFsp + rclone installed (mount supervised by s6)'
}
{{- else}}

    # Connection-string passwords must be rclone-obscured.
    $ob = (& $rclone obscure '{{.SFTPPassword}}' | Select-Object -First 1)
    $remote = ':sftp,host=' + $sftpHost + ',port=' + $sftpPort + ',user={{.SFTPUser}},pass=' + $ob + ':/'

    # A launcher script keeps the task command short and out of task-query
    # output. The loop matters: rclone exits CRITICAL when the host server
    # is not up yet (connection refused, run 20260903T174850) — it does not
    # retry on its own, so the launcher restarts it until the host appears.
    $launcher = Join-Path $rcloneDir 'mount-project.ps1'
    # --vfs-disk-space-total-size: the host sftpshare is a pure SFTP server
    # (no shell, no df), so rclone's Statfs fails — and Windows queries free
    # space before every GUI save, aborting it (run 20260903T181714). A fixed
    # reported size keeps Explorer/notepad happy.
    # -o FileSecurity: the mount runs as SYSTEM, and WinFsp's default ACL
    # synthesis leaves Everyone without FILE_WRITE_EA — a GENERIC_WRITE open
    # (any editor saving an existing file) is denied for every other user
    # (run 20260903T181714). Grant Everyone full access at the volume level;
    # host-side permissions still bound what the SFTP server allows.
    $mountCmd = '& "' + $rclone + '" mount "' + $remote + '" {{.SFTPDrive}}: --volname "{{.SFTPVolumeName}}" -o ''FileSecurity=D:P(A;;FA;;;WD)'' --file-perms 0666 --dir-perms 0777 --links --vfs-cache-mode writes --dir-cache-time 10s --vfs-disk-space-total-size 100G --log-file C:\rclone-mount.log --log-level INFO'
    Set-Content -Path $launcher -Value ("while (`$true) {`n    $mountCmd`n    Start-Sleep -Seconds 15`n}")

    # On-start SYSTEM task, proven shape (CELL-532): a session-launched
    # rclone dies with its session and its drive letter is per-logon; the
    # SYSTEM task survives sessions, remounts on every boot (automount), and
    # the drive is global — visible to all logons and to WSL1 drvfs.
    # Register-ScheduledTask instead of schtasks.exe: the latter failed with a
    # bare E_FAIL (-2147467259) at first logon (run 20260903T160300) and its
    # /tr quoting is fragile; the cmdlet throws a real error message. Retried:
    # the Schedule service can still be settling this early in first logon.
    $action = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument ('-NoProfile -ExecutionPolicy Bypass -File "' + $launcher + '"')
    $trigger = New-ScheduledTaskTrigger -AtStartup
    $registered = $false
    foreach ($i in 1..3) {
        try {
            Register-ScheduledTask -TaskName winkit-rclone-mount -Action $action -Trigger $trigger -User SYSTEM -RunLevel Highest -Force | Out-Null
            $registered = $true; break
        } catch {
            Send-Progress "Register-ScheduledTask attempt ${i}: $($_.Exception.Message)"
            Start-Sleep -Seconds 10
        }
    }
    if (-not $registered) { throw 'Register-ScheduledTask winkit-rclone-mount failed after 3 attempts' }
    Start-ScheduledTask -TaskName winkit-rclone-mount

    # Wait for the drive letter, then prove the full round trip with a
    # write-back marker the host can assert on. The host server may come up
    # after the guest; the mount task keeps retrying at boot regardless.
    $mounted = $false
    foreach ($i in 1..24) {
        if (Test-Path '{{.SFTPDrive}}:\' -ErrorAction SilentlyContinue) { $mounted = $true; break }
        Start-Sleep -Seconds 5
    }
    if (-not $mounted) { throw 'SFTP share did not appear as {{.SFTPDrive}}: (is the host sftpshare server up?)' }

    # Stable path for scripts regardless of the drive letter.
    if (-not (Test-Path 'C:\project')) {
        New-Item -ItemType SymbolicLink -Path 'C:\project' -Target '{{.SFTPDrive}}:\' -Force | Out-Null
    }

    New-Item -ItemType Directory -Path '{{.SFTPDrive}}:\.winkit' -Force | Out-Null
    Set-Content -Path '{{.SFTPDrive}}:\.winkit\sftp-mounted' -Value ("mounted by $env:COMPUTERNAME at " + (Get-Date -Format o))
    Send-Progress "mounted host SFTP share as {{.SFTPDrive}}: (DRIVE_FIXED)"
}
{{- end}}
{{- end}}

Invoke-Step 'install OpenSSH server' {
    # The shipped release first. OpenSSH Server cannot be serviced from our
    # media: its manifest is present but the payload is not, so the capability
    # sits Staged and the capability call fails 0x80070002 even with
    # Windows Update reachable and permitted. The standalone Win32-OpenSSH
    # build needs no servicing at all.
{{- if .OpenSSHPayload}}
    $payload = "$vol\{{.OpenSSHPayload}}"
    if (Test-Path $payload) {
        $dest = Join-Path $env:ProgramFiles 'OpenSSH'
        # The FAT writer cluster-aligns files with trailing newlines. A zip is
        # read from its end, so trim back to the true length before extracting.
        $trimmed = Join-Path $env:TEMP '{{.OpenSSHPayload}}'
        $fs = [System.IO.File]::OpenRead($payload)
        $buf = New-Object byte[] {{.OpenSSHPayloadSize}}
        [void]$fs.Read($buf, 0, {{.OpenSSHPayloadSize}})
        $fs.Close()
        [System.IO.File]::WriteAllBytes($trimmed, $buf)
        Expand-Archive -Path $trimmed -DestinationPath $env:ProgramFiles -Force
        # The release zip unpacks to OpenSSH-Win64/OpenSSH-ARM64; normalise it.
        if (-not (Test-Path (Join-Path $dest 'install-sshd.ps1'))) {
            $inner = Get-ChildItem -Path $env:ProgramFiles -Directory -Filter 'OpenSSH-*' |
                Select-Object -First 1
            if ($inner) { Move-Item -Path $inner.FullName -Destination $dest -Force }
        }
        & (Join-Path $dest 'install-sshd.ps1')
    }
{{- end}}

    # Fallback: the capability. Kept because it is correct on media that does
    # carry the payload, and harmless when it is not.
    if (-not (Get-Service sshd -ErrorAction SilentlyContinue)) {
        # /LogPath writes to the answer volume, the only channel the host can
        # read without SSH.
        DISM /Online /Add-Capability /CapabilityName:OpenSSH.Server~~~~0.0.1.0 /LogLevel:4 /LogPath:"$writeVol\dism.log" | Out-Null
        Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0 -ErrorAction SilentlyContinue | Out-Null
    }

    $state = (Get-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0).State
    if (-not (Get-Service sshd -ErrorAction SilentlyContinue)) {
        throw "sshd absent after offline install and capability attempt; capability state: $state"
    }
}

Invoke-Step 'set PowerShell as the default SSH shell' {
    if (-not (Test-Path 'HKLM:\SOFTWARE\OpenSSH')) {
        New-Item -Path 'HKLM:\SOFTWARE\OpenSSH' -Force | Out-Null
    }
    New-ItemProperty -Path 'HKLM:\SOFTWARE\OpenSSH' -Name DefaultShell -Value 'C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe' -PropertyType String -Force | Out-Null
}
{{- if .SSHPubKey}}

# A here-string carries the keys verbatim: several keys, one per line, no
# quoting or escaping in play.
$pubKeys = @'
{{.SSHPubKey}}
'@

Invoke-Step 'authorize SSH key for administrators' {
    # The account is in Administrators, so sshd consults THIS file and
    # ignores the per-user one. Both are written; this is the load-bearing
    # copy. sshd also refuses key files with loose ACLs, hence icacls.
    $d = Join-Path $env:ProgramData 'ssh'
    if (-not (Test-Path $d)) { New-Item -ItemType Directory -Path $d -Force | Out-Null }
    Set-Content -Path (Join-Path $d 'administrators_authorized_keys') -Value $pubKeys
    icacls (Join-Path $d 'administrators_authorized_keys') /inheritance:r /grant 'SYSTEM:(R)' /grant 'BUILTIN\Administrators:(R)' | Out-Null
}

Invoke-Step 'authorize SSH key for the user' {
    $d = Join-Path $env:USERPROFILE '.ssh'
    if (-not (Test-Path $d)) { New-Item -ItemType Directory -Path $d -Force | Out-Null }
    Set-Content -Path (Join-Path $d 'authorized_keys') -Value $pubKeys
    icacls (Join-Path $d 'authorized_keys') /inheritance:r /grant ($env:USERNAME + ':(R)') | Out-Null
}
{{- end}}

Invoke-Step 'start sshd' {
    Set-Service -Name sshd -StartupType Automatic
    Start-Service sshd
}

Invoke-Step 'open the firewall for SSH' {
    New-NetFirewallRule -Name sshd -DisplayName 'OpenSSH Server (sshd)' -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22 | Out-Null
}

Invoke-Step 'install WSL package' {
    # On 24H2 the System32 wsl.exe is a stub: it cannot install anything.
    # The real WSL runtime ships as an MSI from GitHub. The WSL1 optional
    # feature is enabled during specialize (EnableWSL1Feature). This step
    # installs the user-space runtime so wsl.exe --import is available.
    $arch = if ([Environment]::Is64BitOperatingSystem -and [System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture -eq 'Arm64') { 'arm64' } else { 'x64' }
    $ver = '2.7.12'
    $msiUrl = "https://github.com/microsoft/WSL/releases/download/$ver/wsl.$ver.0.$arch.msi"
    $msiPath = Join-Path $env:TEMP 'wsl.msi'
    $ProgressPreference = 'SilentlyContinue'
    Invoke-WebRequest -Uri $msiUrl -OutFile $msiPath -UseBasicParsing
    $p = Start-Process msiexec.exe -PassThru -ArgumentList '/i', $msiPath, '/quiet', '/qn', '/norestart'
    $p.WaitForExit(300000)
    if ($p.ExitCode -ne 0) { throw "msiexec exited $($p.ExitCode)" }
    # wsl.exe prints UTF-16LE; WSL_UTF8=1 makes its output readable when
    # captured (without it every log line arrives NUL-interleaved).
    $env:WSL_UTF8 = '1'
    $wslVer = & wsl.exe --version 2>&1 | Select-Object -First 1
    Send-Progress "WSL installed: $wslVer"
}

Invoke-Step 'import WSL1 distro' {
    # Look for distro.wsl on any attached drive (lives on the scratch FAT
    # volume; the WSL service cannot import from a CD-ROM/ISO). Skip if not found.
    $wslFile = $null
    foreach ($d in (Get-Volume -ErrorAction SilentlyContinue | Where-Object { $_.DriveLetter })) {
        $candidate = "{0}:\distro.wsl" -f $d.DriveLetter
        if (Test-Path $candidate -ErrorAction SilentlyContinue) {
            $wslFile = $candidate
            break
        }
    }
    if (-not $wslFile) {
        Send-Progress 'no distro.wsl found on any drive; skipping WSL1 import'
        return
    }
    Send-Progress "found $wslFile"
    $distro = '{{.DistroName}}'
    $installDir = "C:\$distro"
    if (Test-Path $installDir) { Remove-Item $installDir -Recurse -Force }
    $env:WSL_UTF8 = '1'

    # Do not rely on the WSL package's current default. Modern WSL defaults to
    # version 2, while winkit's Windows images deliberately require WSL1 so
    # they remain usable without VirtualMachinePlatform or a hypervisor.
    $defaultOut = (& wsl.exe --set-default-version 1 2>&1 | Out-String).Trim()
    if ($LASTEXITCODE -ne 0) { throw "wsl --set-default-version 1 exited $LASTEXITCODE -- $defaultOut" }

    $importOut = (& wsl.exe --import $distro $installDir $wslFile --version 1 2>&1 | Out-String).Trim()
    if ($LASTEXITCODE -ne 0) { throw "wsl --import exited $LASTEXITCODE -- $importOut" }

    # Enforce the requested version even if a future wsl.exe changes import
    # defaults or ignores a trailing --version option. This is intentionally
    # redundant with --import --version 1.
    $convertOut = (& wsl.exe --set-version $distro 1 2>&1 | Out-String).Trim()
    if ($LASTEXITCODE -ne 0) { throw "wsl --set-version $distro 1 exited $LASTEXITCODE -- $convertOut" }

    # WSL generation is encoded by LXSS_DISTRO_FLAGS_VM_MODE (0x8). Modern
    # WSL1 registrations can legitimately use registry Version=2 and an
    # ext4.vhdx file: Version is the root-filesystem metadata schema, not the
    # WSL generation. Refuse success only when the VM-mode bit proves WSL2.
    $lxssRoot = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Lxss'
    $registration = Get-ChildItem -Path $lxssRoot -ErrorAction Stop |
        ForEach-Object { Get-ItemProperty -Path $_.PSPath } |
        Where-Object { $_.DistributionName -eq $distro } |
        Select-Object -First 1
    if (-not $registration) { throw "WSL registration for $distro was not found" }
    if (([int]$registration.Flags -band 0x8) -ne 0) {
        throw "WSL1 enforcement failed for ${distro}: VM_MODE is set in Flags=$($registration.Flags)"
    }
    # wsl.exe writes benign warnings (e.g. a failed fstab pass) to stderr;
    # under ErrorActionPreference=Stop the 2>&1 redirect would promote the
    # first such line to a terminating error and fail the whole step even
    # though the import succeeded. Relax EAP around the verification call.
    $prevEAP = $ErrorActionPreference; $ErrorActionPreference = 'Continue'
    # Distro-agnostic liveness check: -lc so the login shell sources
    # /etc/profile. Recipe-specific verification (nix --version, os-release)
    # runs host-side after the build (wslVerifyDistro).
    # Collect all output before extracting the first line: piping directly
    # into Select-Object -First 1 closes the pipeline early, which makes
    # wsl.exe exit with a broken-pipe error code (-1) even when uname
    # succeeded.
    $bootAll = (wsl.exe -d $distro -e /bin/sh -lc 'uname -a' 2>&1 | Out-String).Trim()
    $bootExit = $LASTEXITCODE
    $ErrorActionPreference = $prevEAP
    $bootOut = ($bootAll -split "`n")[0].Trim()
    if ($bootExit -ne 0) { throw "uname in $distro exited $bootExit -- $bootOut" }
    $script:distroOk = $true
    Send-Progress "$distro imported (WSL1 registry Flags=$($registration.Flags), VM_MODE clear): $bootOut"
}

if (-not $script:distroOk) {
    Send-Progress 'skipping s6 and SFTP steps: WSL distro import failed'
    winkit-json @{ event = 'bootstrap_step'; stage = 'start s6 service supervisor for WSL distro'; status = 'skipped'; error = 'distro import failed' }
}

if ($script:distroOk) {
Invoke-Step 'start s6 service supervisor for WSL distro' {
    $distro = '{{.DistroName}}'
    # s6-svscan is the single entry point for all in-distro services (sshd,
    # future winkit fragments). Runs as SYSTEM so it survives logoff and
    # restarts on every boot. The WSL1 sshd (port 2223) gives real PTY
    # sessions: tab completion, readline, everything Windows OpenSSH pipes lack.
    # /bin/s6-init is the rootfs wrapper that sets PATH (nix profile) and the
    # ofd-shim LD_PRELOAD before exec'ing s6-svscan; s6-svscan itself lives in
    # the nix profile, not /bin, so it must be reached through the wrapper.
{{- if .ServiceBinaryName}}
    # winkit-service wraps wsl.exe as a proper Windows service (SCM restart)
    # and pipes s6-svscan stdout/stderr to the structured virtio-serial port,
    # so the host sees s6 lifecycle events in build.jsonl.
    $svc = 'C:\{{.ServiceBinaryName}}'
    Send-Progress "winkit-service binary: $svc (exists=$(Test-Path $svc))"
    & $svc install --name winkit-s6 --user '.\{{.Username}}' --password '{{.Password}}' --log-serial '{{.StructPort}}' --log-file 'C:\winkit-s6.log' -- wsl.exe -d $distro -u root -e /bin/s6-init
    if ($LASTEXITCODE -ne 0) { throw "winkit-service install exited $LASTEXITCODE" }
    Send-Progress "winkit-s6 service installed"
    & $svc start --name winkit-s6
    if ($LASTEXITCODE -ne 0) { throw "winkit-service start exited $LASTEXITCODE" }
    Start-Sleep -Seconds 2
    $st = & $svc status --name winkit-s6 2>&1
    Send-Progress "winkit-s6 status after start: $st"
{{- else}}
    $action = New-ScheduledTaskAction -Execute 'wsl.exe' -Argument ("-d $distro -u root -e /bin/s6-init")
    $trigger = New-ScheduledTaskTrigger -AtStartup
    $registered = $false
    foreach ($i in 1..3) {
        try {
            Register-ScheduledTask -TaskName winkit-s6 -Action $action -Trigger $trigger -User '.\{{.Username}}' -Password '{{.Password}}' -RunLevel Highest -Force | Out-Null
            $registered = $true; break
        } catch {
            Send-Progress "Register-ScheduledTask s6 attempt ${i}: $($_.Exception.Message)"
            Start-Sleep -Seconds 10
        }
    }
    if (-not $registered) { throw 'Register-ScheduledTask winkit-s6 failed after 3 attempts' }
    Start-ScheduledTask -TaskName winkit-s6
{{- end}}
    Send-Progress "s6-svscan started for $distro (sshd on 127.0.0.1:2223)"
}
{{- if and .SFTPPort .RcloneViaS6}}

Invoke-Step 'verify s6-supervised SFTP mount' {
    # The rclone-mount s6 service (baked into the distro) execs the Windows
    # rclone.exe via interop; s6-supervise retries until the host server is
    # reachable. Wait for the drive, then prove the full round trip with a
    # write-back marker the host can assert on.
    $mounted = $false
    foreach ($i in 1..24) {
        if (Test-Path '{{.SFTPDrive}}:\' -ErrorAction SilentlyContinue) { $mounted = $true; break }
        Start-Sleep -Seconds 5
    }
    if (-not $mounted) {
        Send-Progress "SFTP mount failed; dumping diagnostics"
        # Check s6 supervisor state
        try {
            $s6stat = wsl.exe -d '{{.DistroName}}' -u root -e /bin/sh -lc 's6-svstat /etc/s6/services/rclone-mount 2>&1; echo "---"; s6-svstat /etc/s6/services/myagent 2>&1' 2>&1 | Out-String
            Send-Progress "s6-svstat: $($s6stat.Trim())"
        } catch { Send-Progress "s6-svstat failed: $($_.Exception.Message)" }
        # Check winkit-s6 service status
        try {
            $svcSt = & 'C:\{{.ServiceBinaryName}}' status --name winkit-s6 2>&1 | Out-String
            Send-Progress "winkit-s6 svc status: $($svcSt.Trim())"
        } catch { Send-Progress "winkit-s6 status check failed: $($_.Exception.Message)" }
        # Dump the service log
        if (Test-Path 'C:\winkit-s6.log') {
            $svcLog = Get-Content 'C:\winkit-s6.log' -Tail 30 -ErrorAction SilentlyContinue | Out-String
            Send-Progress "winkit-s6.log tail: $($svcLog.Trim())"
        } else { Send-Progress "C:\winkit-s6.log does not exist" }
        throw 'SFTP share did not appear as {{.SFTPDrive}}: (is the host sftpshare server up?)'
    }

    # Stable path for scripts regardless of the drive letter.
    if (-not (Test-Path 'C:\project')) {
        New-Item -ItemType SymbolicLink -Path 'C:\project' -Target '{{.SFTPDrive}}:\' -Force | Out-Null
    }

    New-Item -ItemType Directory -Path '{{.SFTPDrive}}:\.winkit' -Force | Out-Null
    Set-Content -Path '{{.SFTPDrive}}:\.winkit\sftp-mounted' -Value ("mounted by $env:COMPUTERNAME at " + (Get-Date -Format o))
    Send-Progress "mounted host SFTP share as {{.SFTPDrive}}: (DRIVE_FIXED, s6-supervised)"
}
{{- end}}
}

{{- if or .WallpaperName .WallpaperPath}}

Invoke-Step 'set desktop wallpaper' {
{{- if .WallpaperName}}
    $wpDir = 'C:\Windows\Web\Wallpaper\winkit'
    if (-not (Test-Path $wpDir)) { New-Item -ItemType Directory -Path $wpDir -Force | Out-Null }
    $src = "$vol\{{.WallpaperName}}"
    $dest = Join-Path $wpDir '{{.WallpaperName}}'
    Copy-Item -Path $src -Destination $dest -Force
    $wpPath = $dest
{{- else}}
    $wpPath = '{{.WallpaperPath}}'
{{- end}}
    Set-ItemProperty -Path 'HKCU:\Control Panel\Desktop' -Name Wallpaper -Value $wpPath -Type String
    Set-ItemProperty -Path 'HKCU:\Control Panel\Desktop' -Name WallpaperStyle -Value '10' -Type String
    Set-ItemProperty -Path 'HKCU:\Control Panel\Desktop' -Name TileWallpaper -Value '0' -Type String
    if (-not ('Win32.Wallpaper' -as [type])) {
        Add-Type -TypeDefinition @'
using System.Runtime.InteropServices;
public class Win32Wallpaper {
    [DllImport("user32.dll", CharSet = CharSet.Auto)]
    public static extern int SystemParametersInfo(int uAction, int uParam, string lpvParam, int fuWinIni);
}
'@
    }
    [Win32Wallpaper]::SystemParametersInfo(0x0014, 0, $wpPath, 0x03) | Out-Null
}
{{- end}}
{{- range .CustomSteps}}

Invoke-Step '{{.Name}}' {
{{.Script}}
}
{{- end}}

Invoke-Step 'run guest diagnostics' {
    # Last, so the report records the outcome of everything above.
    $diag = "$vol\winkit-diag.ps1"
    if (Test-Path $diag) { & $diag }
}

if ($script:failed.Count -gt 0) {
    Send-Progress ("done with {0} FAILED step(s): {1}" -f $script:failed.Count, ($script:failed -join ', '))
    winkit-json @{ event = 'bootstrap_done'; status = 'partial'; failed = $script:failed }
} else {
    Send-Progress 'done, all steps ok'
    winkit-json @{ event = 'bootstrap_done'; status = 'ok' }
}
if ($structStream) { $structStream.Flush(); $structStream.Close() }
try { Stop-Transcript } catch { Write-Warning "could not stop transcript: $_" }
exit 0
