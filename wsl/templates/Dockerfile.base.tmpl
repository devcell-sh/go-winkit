FROM {{.Base}}

ARG WSL_USER=dev

# Universal WSL1 plumbing over an arbitrary base image. Only POSIX sh and
# best-effort package-manager detection — every step that cannot work on a
# given base degrades instead of failing the build.

# --- WSL configuration (WSL 1: no systemd, no kernel) ---
RUN mkdir -p /etc \
 && printf "[user]\ndefault = ${WSL_USER}\n\n[interop]\nenabled = true\nappendWindowsPath = true\n\n[boot]\nsystemd = false\n" \
      > /etc/wsl.conf

# --- WSL distribution OOBE config ---
RUN printf "[oobe]\ncommand = /etc/wsl-oobe.sh\ndefaultUid = 1000\ndefaultName = wsl1\n\n[shortcut]\nenabled = true\n" \
      > /etc/wsl-distribution.conf

# --- OOBE script: create user on first launch (fallback; user is baked below) ---
RUN cat > /etc/wsl-oobe.sh <<OOBE
#!/bin/sh
set -e
if id ${WSL_USER} >/dev/null 2>&1; then
  exit 0
fi
useradd -m -u 1000 -s /bin/sh ${WSL_USER} 2>/dev/null || adduser -D -u 1000 -s /bin/sh ${WSL_USER}
OOBE
RUN chmod +x /etc/wsl-oobe.sh

# --- Empty fstab: WSL1 runs "mount -a" at boot; missing fstab causes errors ---
RUN touch /etc/fstab

# --- Packages (best effort per package manager): real mount for drvfs
# automount (util-linux; busybox's is not enough), bash for login shells,
# sudo, openssh for in-distro PTY sessions. ---
RUN if command -v apk >/dev/null 2>&1; then \
      apk add --no-cache bash sudo shadow util-linux openssh s6; \
    elif command -v apt-get >/dev/null 2>&1; then \
      apt-get update \
   && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash sudo util-linux openssh-server \
   && (DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends s6 || true) \
   && rm -rf /var/lib/apt/lists/*; \
    elif command -v dnf >/dev/null 2>&1; then \
      dnf install -y bash sudo util-linux openssh-server && dnf clean all; \
    else \
      echo 'no known package manager; shipping base as-is'; \
    fi

# --- Login wrapper: WSL1's /init starts the user's shell without login/
# interactive flags, so bash reads no startup files. The wrapper re-execs
# as a login+interactive shell (falling back to sh on bash-less bases). ---
RUN mkdir -p /usr/local/bin \
 && printf '#!/bin/sh\nif command -v bash >/dev/null 2>&1; then exec bash -li; fi\nexec sh -l\n' \
      > /usr/local/bin/login-shell \
 && chmod +x /usr/local/bin/login-shell \
 && ln -sf /usr/local/bin/login-shell /bin/login-shell

# --- Create user in the image (OOBE is a fallback) ---
RUN if ! id ${WSL_USER} >/dev/null 2>&1; then \
      useradd -m -u 1000 -s /bin/login-shell ${WSL_USER} 2>/dev/null \
   || adduser -D -u 1000 -s /bin/login-shell ${WSL_USER}; \
    fi \
 && if command -v sudo >/dev/null 2>&1; then \
      mkdir -p /etc/sudoers.d \
   && echo "${WSL_USER} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${WSL_USER} \
   && chmod 0440 /etc/sudoers.d/${WSL_USER}; \
    fi

# --- In-distro sshd (best effort): WSL1 starts the user shell without a
# PTY (Windows OpenSSH hands WSL pipes), so an in-distro sshd on port 2223
# gives real PTY sessions. Only configured when openssh installed above. ---
RUN if command -v sshd >/dev/null 2>&1 || [ -x /usr/sbin/sshd ]; then \
      mkdir -p /etc/ssh /run/sshd \
   && ssh-keygen -A \
   && { [ -d /etc/ssh/sshd_config.d ] \
        && printf 'Port 2223\nListenAddress 127.0.0.1\nPermitRootLogin yes\nPasswordAuthentication yes\nUsePAM no\nSubsystem sftp internal-sftp\n' \
             > /etc/ssh/sshd_config.d/winkit.conf \
        || printf '\nPort 2223\nListenAddress 127.0.0.1\nPermitRootLogin yes\nPasswordAuthentication yes\nUsePAM no\n' \
             >> /etc/ssh/sshd_config; }; \
    fi

# --- s6 service dirs: COPY'd from the build context (wsl.Recipe services
# land under s6/<name>/; sshd is always seeded). Context files arrive
# 0644, so run/finish get their executable bit restored here. On bases
# without s6 (dnf family) the dirs exist but only sshd runs, via the
# s6-init fallback below. ---
COPY s6/ /etc/s6/services/
RUN find /etc/s6/services -type f \( -name run -o -name finish \) -exec chmod +x {} +

# --- /bin/s6-init: the Windows bootstrap registers a boot task that runs
# "wsl.exe -e /bin/s6-init", so the entry point must exist on every image.
# s6-svscan supervises everything under /etc/s6/services when s6 is
# installed; otherwise fall back to exec'ing sshd directly (no supervision,
# still a working 2223); a base with neither just parks. ---
RUN printf '#!/bin/sh\nif command -v s6-svscan >/dev/null 2>&1; then exec s6-svscan /etc/s6/services; fi\nif command -v sshd >/dev/null 2>&1 || [ -x /usr/sbin/sshd ]; then exec /etc/s6/services/sshd/run; fi\nexec sleep infinity\n' \
      > /bin/s6-init \
 && chmod +x /bin/s6-init

CMD ["/bin/login-shell"]
