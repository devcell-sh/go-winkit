FROM nixos/nix:latest

ARG WSL_USER=dev
# NIXHOME_REF, when non-empty, is a remote flake ref (git URL, github:owner/
# repo, …) used instead of the COPY'd ./nixhome directory.
ARG NIXHOME_REF=""
# NIXHOME_ATTR overrides the homeConfigurations attribute name. Defaults to
# WSL_USER so embedded flakes (which template @USER@) work unchanged.
# External flakes (community-home) use a different naming scheme
# (e.g. wsl-ultimate-aarch64) and pass it here.
ARG NIXHOME_ATTR=""
# NIXHOME_USER is the username the external flake's home-manager config was
# built for (e.g. "nixos" for community-home WSL configs). When it differs
# from WSL_USER, symlinks redirect the flake's paths to WSL_USER's real
# home, so activation writes to the right place and the distro user gets
# all the managed dotfiles.
ARG NIXHOME_USER=""

# --- WSL configuration (WSL 1: no systemd, no kernel) ---
RUN mkdir -p /etc \
 && printf "[user]\ndefault = ${WSL_USER}\n\n[interop]\nenabled = true\nappendWindowsPath = true\n\n[boot]\nsystemd = false\n" \
      > /etc/wsl.conf

# --- WSL distribution OOBE config ---
RUN printf "[oobe]\ncommand = /etc/wsl-oobe.sh\ndefaultUid = 1000\ndefaultName = nix-wsl1\n\n[shortcut]\nenabled = true\n" \
      > /etc/wsl-distribution.conf

# --- OOBE script: create user on first launch ---
RUN cat > /etc/wsl-oobe.sh <<OOBE
#!/bin/sh
set -e
if id ${WSL_USER} >/dev/null 2>&1; then
  exit 0
fi
adduser -D -u 1000 -s /bin/bash ${WSL_USER}
mkdir -p /etc/sudoers.d
echo '${WSL_USER} ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/${WSL_USER}
chmod 0440 /etc/sudoers.d/${WSL_USER}
OOBE
RUN chmod +x /etc/wsl-oobe.sh

# --- Empty fstab: WSL1 runs "mount -a" at boot; missing fstab causes errors ---
RUN touch /etc/fstab

# --- Nix config: disable sandbox (WSL 1 lacks namespaces) ---
RUN mkdir -p /etc/nix \
 && printf 'sandbox = false\nexperimental-features = nix-command flakes\n' \
      >> /etc/nix/nix.conf

# --- Profile hooks: sourced by login shells via /etc/profile ---
RUN mkdir -p /etc/profile.d \
 && printf '#!/bin/sh\nif [ -e /nix/var/nix/profiles/default/etc/profile.d/nix.sh ]; then\n  . /nix/var/nix/profiles/default/etc/profile.d/nix.sh\nfi\n' \
      > /etc/profile.d/nix.sh \
 && chmod +x /etc/profile.d/nix.sh

# --- Base /etc/profile: make sure login shells run the profile.d hooks ---
# The nixos/nix base image has no guarantee of one; without it a login shell
# (bash -l, wsl.exe -e bash -li, in-distro sshd) gets neither nix on PATH nor
# any of the hooks above.
RUN touch /etc/profile \
 && if ! grep -q 'profile\.d' /etc/profile; then \
      printf '\nfor f in /etc/profile.d/*.sh; do [ -r "$f" ] && . "$f"; done\nunset f\n' >> /etc/profile; \
    fi

# --- Boot-time system utilities (must be available before any user profile) ---
# util-linux: WSL1 runs "mount -a" at boot; missing /bin/mount breaks drvfs.
# glibcLocales: must be in the default profile so the /usr/lib/locale symlink
# resolves (HM's user profile isn't visible to glibc's setlocale at C level).
RUN nix-env -iA nixpkgs.util-linux nixpkgs.glibcLocales nixpkgs.s6

# --- /bin entries for WSL1's /init ---
# /init execs these by absolute path (or a PATH that never includes the nix
# profile) before any profile script runs, so they must exist in /bin:
#   mount/umount: the boot-time "mount -a" fstab pass and drvfs automount
#   bash: #!/bin/bash shebangs and the login-bash wrapper's PATH lookup
# The link target is the profile indirection (stable across generations),
# not a store hash.
RUN ln -sf /nix/var/nix/profiles/default/bin/mount  /bin/mount \
 && ln -sf /nix/var/nix/profiles/default/bin/umount /bin/umount \
 && ln -sf /nix/var/nix/profiles/default/bin/bash   /bin/bash

# --- Locale: symlink the nix locale archive to glibc's standard path so
# setlocale() finds it before any shell starts (Docker ENV is lost on export). ---
RUN mkdir -p /usr/lib/locale \
 && ln -sf /nix/var/nix/profiles/default/lib/locale/locale-archive /usr/lib/locale/locale-archive

# --- Login wrapper: WSL1's /init starts the user's shell without a PTY
# and without login/interactive flags, so bash reads no startup files.
# Docker ENV is lost on export, and WSL1 doesn't read /etc/environment.
# The wrapper re-execs as a login+interactive shell so bash loads
# /etc/profile and ~/.bashrc (HM-managed).
# When arguments are present (e.g. SSH sends -c "command"), forward them
# to bash -l so remote commands execute instead of being dropped. ---
RUN mkdir -p /usr/local/bin \
 && printf '#!/bin/sh\nif [ $# -gt 0 ]; then\n    exec bash -l "$@"\nelse\n    exec bash -li\nfi\n' > /usr/local/bin/login-bash \
 && chmod +x /usr/local/bin/login-bash \
 && ln -sf /usr/local/bin/login-bash /bin/login-bash

# --- Account database. nixos/nix ships /etc/passwd, group and shadow as
# symlinks into a read-only store path; appending through them mutates the
# store and later GC or store repair can revert it. Replace them with real
# files first. glibc also needs /etc/nsswitch.conf: without it every NSS
# lookup stats the missing file and leaves errno=ENOENT behind, which
# s6-envuidgid (used by s6-setuidgid) reports as "unable to get
# supplementary groups" even though the group exists. The sshd privilege
# separation user and /var/empty are required for sshd to start. ---
RUN for f in passwd group shadow; do \
      cp --remove-destination "$(readlink -f /etc/$f)" /etc/$f.winkit && mv /etc/$f.winkit /etc/$f; \
    done \
 && chmod 644 /etc/passwd /etc/group && chmod 600 /etc/shadow \
 && printf 'passwd: files\ngroup: files\nshadow: files\nhosts: files dns\n' > /etc/nsswitch.conf \
 && (grep -q '^sshd:' /etc/passwd || echo 'sshd:x:74:74:sshd privsep:/var/empty:/bin/false' >> /etc/passwd) \
 && (grep -q '^sshd:' /etc/group || echo 'sshd:x:74:' >> /etc/group) \
 && mkdir -p /var/empty && chmod 755 /var/empty

# --- Create user in the image (OOBE is a fallback). The primary group
# must exist too: s6-setuidgid/s6-envuidgid resolve the user's groups and
# chown by name fails without it. ---
RUN echo "${WSL_USER}:x:1000:1000::/home/${WSL_USER}:/bin/login-bash" >> /etc/passwd \
 && echo "${WSL_USER}:!:1::::::" >> /etc/shadow \
 && (grep -q "^${WSL_USER}:" /etc/group || echo "${WSL_USER}:x:1000:" >> /etc/group) \
 && mkdir -p /home/${WSL_USER} \
 && chown 1000:1000 /home/${WSL_USER} \
 && mkdir -p /etc/sudoers.d \
 && echo "${WSL_USER} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${WSL_USER} \
 && chmod 0440 /etc/sudoers.d/${WSL_USER}

# --- Home Manager: the user environment is declarative nix config, not
# Dockerfile string-appends. The build context always carries ./nixhome
# (the embedded default flake, or the caller's WINKIT_NIXHOME/--nixhome
# directory); NIXHOME_REF overrides it with a remote flake ref. The flake
# must expose homeConfigurations.<user>. Users iterate inside the distro:
# edit ~/.config/home-manager && home-manager switch.
COPY nixhome /etc/nixhome
# Activation runs as root (single-user nix store) with HOME/USER pointing at
# the distro user; the per-user profile dirs must pre-exist or HM aborts
# with "could not find suitable profile directory". chown afterwards so
# "home-manager switch" works as the user inside the distro.
# Stub sudo for activation: HM hooks call sudo but the build runs as root;
# the real binary is installed after activation from the profile.
RUN printf '#!/bin/sh\nexec "$@"\n' > /usr/bin/sudo && chmod +x /usr/bin/sudo

RUN FLAKE="${NIXHOME_REF:-path:/etc/nixhome}" \
 && ATTR="${NIXHOME_ATTR:-${WSL_USER}}" \
 && HM_USER="${NIXHOME_USER:-${WSL_USER}}" \
 && mkdir -p /home/${WSL_USER}/.local/state/nix/profiles \
      /nix/var/nix/profiles/per-user/${WSL_USER} \
      /nix/var/nix/gcroots/per-user/${WSL_USER} \
 && if [ "${HM_USER}" != "${WSL_USER}" ]; then \
      ln -sfnT /home/${WSL_USER} /home/${HM_USER}; \
      ln -sfnT /nix/var/nix/profiles/per-user/${WSL_USER} /nix/var/nix/profiles/per-user/${HM_USER}; \
      ln -sfnT /nix/var/nix/gcroots/per-user/${WSL_USER} /nix/var/nix/gcroots/per-user/${HM_USER}; \
    fi \
 && chown -R 0:0 /home/${WSL_USER} \
 && ACT=$(nix build --no-link --print-out-paths "$FLAKE#homeConfigurations.${ATTR}.activationPackage") \
 && HOME=/home/${HM_USER} USER=${HM_USER} HOME_MANAGER_BACKUP_EXT=winkit-bak "$ACT/activate" \
 && chown -R 1000:1000 /home/${WSL_USER} \
      /nix/var/nix/profiles/per-user/${WSL_USER} \
      /nix/var/nix/gcroots/per-user/${WSL_USER}

# --- Fontconfig bridge (what devcell's image.nix does). nixpkgs fontconfig
# looks for /etc/fonts/fonts.conf; without it every X11 app logs "Cannot
# load default config file" and sees only the bundled DejaVu. The default
# fonts.conf is copied (not linked, so GC cannot pull it away) and its
# /etc/fonts/conf.d include is pointed at home-manager's conf.d, which adds
# the profile's font dirs and the serif/sans/mono aliases. The shared cache
# dir is world-writable so the first app to run can populate it. ---
RUN FC="$(ls /nix/store/*-fontconfig-[0-9]*/etc/fonts/fonts.conf 2>/dev/null | head -1)" \
 && if [ -n "$FC" ] && [ -d /home/${WSL_USER}/.config/fontconfig/conf.d ]; then \
      mkdir -p /etc/fonts /var/cache/fontconfig \
      && chmod 1777 /var/cache/fontconfig \
      && cp "$FC" /etc/fonts/fonts.conf \
      && ln -sfn /home/${WSL_USER}/.config/fontconfig/conf.d /etc/fonts/conf.d \
      && if [ -x /home/${WSL_USER}/.nix-profile/bin/fc-cache ]; then \
           HOME=/home/${WSL_USER} /home/${WSL_USER}/.nix-profile/bin/fc-cache >/dev/null 2>&1 || true; \
           chown -R 1000:1000 /home/${WSL_USER}/.cache 2>/dev/null || true; \
         fi; \
    fi

# --- PATH setup: add nix profile dirs so all shells find nix/HM binaries.
# WSL1's minimal PATH is /usr/bin:/bin; instead of symlinking every binary
# there, we extend PATH in profile.d (login shells) and in the s6-init
# wrapper (direct wsl.exe -e invocations). ---
RUN printf "export PATH=\"/home/${WSL_USER}/.nix-profile/bin:/nix/var/nix/profiles/default/bin:\$PATH\"\n" \
      > /etc/profile.d/nix-path.sh \
 && chmod +x /etc/profile.d/nix-path.sh

# --- DNS fallback: WSL1 under WinPE regenerates /etc/resolv.conf at every
# distro start but leaves it without nameservers (the Windows side resolves
# fine). s6-init runs this before s6-svscan: it prefers the list the
# WSL1 bootstrap exports to <data disk>\winkit\resolv.conf (visible via
# drvfs as /mnt/<x>/winkit), then public resolvers. A resolv.conf that
# already names a server, as on full Windows, is left alone. ---
RUN printf '#!/bin/sh\n\
grep -q "^nameserver" /etc/resolv.conf 2>/dev/null && exit 0\n\
for f in /mnt/*/winkit/resolv.conf; do\n\
  [ -r "$f" ] && grep -q "^nameserver" "$f" && { cat "$f" >> /etc/resolv.conf; break; }\n\
done\n\
grep -q "^nameserver" /etc/resolv.conf || printf "nameserver 1.1.1.1\\nnameserver 8.8.8.8\\n" >> /etc/resolv.conf\n' \
      > /bin/winkit-resolv \
 && chmod +x /bin/winkit-resolv

# --- s6-init: entry point for "wsl.exe -e /bin/s6-init" (no login shell,
# so profile.d is not sourced). Sets PATH + LD_PRELOAD, then execs
# s6-svscan so child run scripts inherit the environment. ---
RUN printf '#!/bin/sh\n. /etc/profile.d/nix-path.sh\n. /etc/profile.d/ofd-shim.sh\n/bin/winkit-resolv\nexec s6-svscan /etc/s6/services\n' \
      > /bin/s6-init \
 && chmod +x /bin/s6-init

# --- OFD lock shim: WSL1's lxcore.sys does not implement F_OFD_SETLK
# (fcntl 37), which Nix's C SQLite 3.49+ uses. Without this shim every
# nix-env/nix-build inside the running distro fails with "unable to open
# database file". The shim downgrades OFD locks to classic POSIX locks.
COPY ofd-shim.c /tmp/ofd-shim.c
RUN nix-shell -p gcc --run 'gcc -shared -fPIC -o /usr/lib/ofd-shim.so /tmp/ofd-shim.c -ldl' \
 && rm /tmp/ofd-shim.c
RUN printf 'export LD_PRELOAD=/usr/lib/ofd-shim.so\n' > /etc/profile.d/ofd-shim.sh \
 && chmod +x /etc/profile.d/ofd-shim.sh

# --- In-distro sshd via s6: WSL1 starts the user shell without a PTY
# (Windows OpenSSH hands WSL pipes), so tab completion and readline are
# broken. An in-distro sshd on port 2223 gives real PTY sessions.
# s6-svscan is the single process supervisor: one Windows scheduled task
# starts it, and it manages sshd (and future services). ---

# sshd_config: local-only, password auth, port 2223.
RUN mkdir -p /etc/ssh \
 && ssh-keygen -A \
 && cat > /etc/ssh/sshd_config <<SSHD
Port 2223
ListenAddress 127.0.0.1
PermitRootLogin yes
PasswordAuthentication yes
UsePAM no
Subsystem sftp internal-sftp
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key
SSHD

# --- s6 service dirs: COPY'd from the build context (wsl.Recipe services
# land under s6/<name>/; sshd is always seeded). Context files arrive
# 0644, so run/finish get their executable bit restored here. ---
COPY s6/ /etc/s6/services/
RUN find /etc/s6/services -type f \( -name run -o -name finish \) -exec chmod +x {} +

# --- Fix sudo: nix cannot install setuid binaries (store is user-owned).
# Copy the real binary to /usr/bin with the setuid bit so "sudo" works.
# The embedded home.nix puts sudo in the profile; a caller's own flake may
# not, so fall back to nixpkgs' sudo rather than failing the build. ---
RUN SUDO="$(readlink -f /home/${WSL_USER}/.nix-profile/bin/sudo 2>/dev/null || true)" \
 && if [ ! -e "$SUDO" ]; then SUDO="$(nix-build '<nixpkgs>' -A sudo --no-out-link)/bin/sudo"; fi \
 && install -m 4755 -o root -g root "$SUDO" /usr/bin/sudo

# --- Shrink the rootfs before export: build-time inputs (nixpkgs and
# flake sources, the tarball cache, superseded generations) are dead
# weight in the guest and inflate distro.wsl and the import on the data
# disk. The user profile, the default profile and the s6/sshd closure are
# GC roots and survive. The sanity check fails the build rather than
# shipping a rootfs whose profile points at a collected store path. ---
RUN nix-collect-garbage -d \
 && rm -rf /root/.cache/nix /tmp/* \
 && test -e "$(readlink -f /home/${WSL_USER}/.nix-profile)" \
 && test -e "$(readlink -f /nix/var/nix/profiles/default/bin/s6-svscan)"

CMD ["/bin/bash", "-l"]
